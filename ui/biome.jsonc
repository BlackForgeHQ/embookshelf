{
  "$schema": "https://biomejs.dev/schemas/2.5.5/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": [
      "src/**/*.ts",
      "src/**/*.tsx",
      // Generated by TanStack Router; regenerated on every build.
      "!src/routeTree.gen.ts",
      "!**/dist",
      "!**/node_modules"
    ]
  },
  // Prettier keeps the formatter role. It carries prettier-plugin-tailwindcss,
  // which sorts Tailwind class strings, and Biome has no stable equivalent —
  // two formatters would also fight over every file.
  "formatter": { "enabled": false },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      // Off wholesale, deliberately. The ESLint config this replaces carried
      // no jsx-a11y plugin, so Biome's recommended a11y set would import 48
      // findings that predate the migration and have nothing to do with it.
      // Worth turning on — there is already a library-a11y e2e spec, so the
      // project cares — but as its own change, where the fixes read as
      // accessibility work rather than as migration noise.
      "a11y": { "recommended": false },
      "correctness": {
        // The port of react-hooks/exhaustive-deps. Warn rather than error:
        // Biome flags 26 sites where ESLint's version flagged 11, and the
        // extra 15 are a different heuristic, not 15 new bugs. Visible
        // without blocking, until someone triages them.
        "useExhaustiveDependencies": "warn"
      },
      "style": {
        "noNonNullAssertion": "off",
        "useImportType": "error"
      },
      "suspicious": {
        // Real footguns the old config never checked, so they land as
        // warnings rather than as an error wall on day one.
        "noArrayIndexKey": "warn",
        "noExplicitAny": "warn"
      }
    }
  }
}
