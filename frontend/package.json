{
  "name": "embookshelf-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n css,vite -c auto \"npm:css:watch\" \"vite dev\"",
    "build": "npm run css && vite build && node scripts/sync-dist.mjs",
    "css": "tailwindcss -i src/styles.css -o src/generated.css --minify",
    "css:watch": "tailwindcss -i src/styles.css -o src/generated.css --watch",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/context-zone": "^2.7.0",
    "@opentelemetry/core": "^2.7.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.215.0",
    "@opentelemetry/instrumentation": "^0.215.0",
    "@opentelemetry/instrumentation-document-load": "^0.60.0",
    "@opentelemetry/instrumentation-fetch": "^0.215.0",
    "@opentelemetry/instrumentation-user-interaction": "^0.59.0",
    "@opentelemetry/resources": "^2.7.0",
    "@opentelemetry/sdk-trace-base": "^2.7.0",
    "@opentelemetry/sdk-trace-web": "^2.7.0",
    "@opentelemetry/semantic-conventions": "^1.40.0",
    "@tanstack/react-query": "^5.59.16",
    "@tanstack/react-router": "latest",
    "@tanstack/react-start": "latest",
    "epubjs": "^0.3.93",
    "h3-v2": "npm:h3@^2.0.0-rc.20",
    "pdfjs-dist": "^5.6.205",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.2.2",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "concurrently": "^9.0.1",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.6.3",
    "vite": "^7.0.0"
  }
}
