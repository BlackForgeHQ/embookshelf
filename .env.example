# Copy to .env for local development.
EMBOOKSHELF_PORT=6060
DATABASE_URL=postgres://embookshelf:embookshelf@localhost:5432/embookshelf?sslmode=disable
DATABASE_MAX_CONNS=20
DATABASE_MIN_CONNS=5
ALLOWED_ORIGINS=*
LOG_LEVEL=info
BOOKDROP_PATH=./bookdrop
BOOKDROP_POLL_SECONDS=5
DATA_PATH=./data
# Apply pending app migrations automatically on server start. Set to false
# if migrations are managed externally (e.g. via `go run ./cmd/migrate up`).
MIGRATE_ON_START=true

# Public origin of this instance. Feeds the OIDC redirect URI
# (${APP_URL}/api/v1/auth/oidc/callback) and absolute links in
# transactional email (password reset, admin invite). Leave unset for
# local dev — the auth and email layers fall back to request-host.
# APP_URL=https://embookshelf.example.com

# OpenTelemetry / OTLP export. When OTEL_ENABLED=true the server pushes
# traces, metrics, and logs to the configured OTLP endpoint. For local
# dev with `make obs-up` (grafana/otel-lgtm): use localhost:4317 (grpc)
# or http://localhost:4318 (http/protobuf).
OTEL_ENABLED=true
OTEL_SERVICE_NAME=embookshelf
OTEL_EXPORTER_OTLP_ENDPOINT=localhost:4317
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
OTEL_EXPORTER_OTLP_INSECURE=true
# Head-based trace sampling ratio (0.0 — 1.0). 1.0 = record everything.
OTEL_TRACES_SAMPLER_ARG=1.0

# Browser OpenTelemetry — consumed by Vite at build/dev time. The browser
# posts to /v1/traces which Vite (dev) or the Go server (prod, if you
# wire it) forwards to the OTLP HTTP receiver. `make up-otlp` sets these
# automatically; uncomment to enable with `make up`.
# VITE_OTEL_ENABLED=true
# VITE_OTEL_SERVICE_NAME=embookshelf-frontend
# VITE_OTEL_OTLP_ENDPOINT=/v1/traces

# ---------------------------------------------------------------------------
# Shared S3 bucket for s3-kind libraries
# ---------------------------------------------------------------------------
#
# When EMBOOKSHELF_S3_BUCKET is set, the library-create UI offers an
# "S3" option that allocates a prefix in this bucket (libraries/{slug}/).
# Single bucket per deployment; each library gets its own prefix.
# EMBOOKSHELF_S3_BUCKET=my-embookshelf-library
# EMBOOKSHELF_S3_REGION=us-east-1
# EMBOOKSHELF_S3_ENDPOINT=
# EMBOOKSHELF_S3_ACCESS_KEY_ID=
# EMBOOKSHELF_S3_SECRET_ACCESS_KEY=
# EMBOOKSHELF_S3_FORCE_PATH_STYLE=false
#
# When ACCESS_KEY_ID / SECRET_ACCESS_KEY are empty, the AWS SDK reads
# AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY, AWS_REGION, AWS_PROFILE, etc.
# from the environment. Set them here for credential-chain auth:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1

# AES-256-GCM key for at-rest encryption of secrets (provider API keys,
# S3 access keys stored in storage_backends.config). Generate with
# `openssl rand -base64 32`. Unset = plaintext + a loud warning at boot.
# EMBOOKSHELF_SECRET_KEY=

# Presigned-URL redirect for S3-backed book downloads (Plan G). When the
# backing storage advertises CapPresign, /api/books/:id/file 302-redirects
# to a presigned GET URL valid for PRESIGN_TTL. Set FALLBACK=stream to
# disable the redirect and stream bytes through the app server instead
# (useful for clients that can't follow cross-origin redirects).
EMBOOKSHELF_PRESIGN_TTL=10m
# EMBOOKSHELF_PRESIGN_FALLBACK=stream

# Grace window before the S3 rename sweeper deletes old keys left
# behind by an S3 folder rename (ADR-0005). Empty = compute at boot
# as max(2 × PRESIGN_TTL, 1h). Accepts Go duration strings (e.g. 30m, 2h).
# EMBOOKSHELF_S3_RENAME_GRACE=1h
