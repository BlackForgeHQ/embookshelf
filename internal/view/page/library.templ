package page

import (
	"github.com/blackforge/embookshelf/internal/model"
	"github.com/blackforge/embookshelf/internal/view/component"
	"github.com/blackforge/embookshelf/internal/view/layout"
	"github.com/blackforge/embookshelf/internal/view/partial"
)

templ Library(libraries []model.Library, shelves []model.Shelf, books []model.Book, activeSlug string, params model.SearchParams, diskMode string) {
	@layout.App("Library") {
		<div class="app-shell">
			@component.Sidebar(libraries, shelves, activeSlug, "", component.NavLibrary)
			<main class="main">
				@component.TopBar("Library", "All your books, in one place.")
				<div class="p-8 grow">
					@component.SearchToolbar(activeSlug, params)
					@partial.LibraryGrid(books)
				</div>
				@component.StatusBar(len(libraries), len(books), diskMode)
			</main>
		</div>
	}
}
