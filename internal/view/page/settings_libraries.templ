package page

import (
	"github.com/blackforge/embookshelf/internal/model"
	"github.com/blackforge/embookshelf/internal/view/component"
	"github.com/blackforge/embookshelf/internal/view/layout"
)

templ SettingsLibraries(libraries []model.Library, shelves []model.Shelf, paths []model.LibraryPath, diskMode string) {
	@layout.App("Libraries · Settings") {
		<div class="app-shell">
			@component.Sidebar(libraries, shelves, "", "", component.NavSettings)
			<main class="main">
				@component.TopBar("Libraries", "Filesystem roots scanned into this instance.")
				<div class="p-8 grow">
					<div class="settings-shell">
						@settingsNav("libraries")
						<section class="settings-panel">
							<h2 class="t-h2">Libraries</h2>
							<p class="t-small mt-2">Scans stage new files into the BookDrop queue for review.</p>

							for _, lib := range libraries {
								@libraryBlock(lib, paths)
							}
						</section>
					</div>
				</div>
				@component.StatusBar(len(libraries), len(paths), diskMode)
			</main>
		</div>
	}
}

templ libraryBlock(lib model.Library, paths []model.LibraryPath) {
	<article class="library-block">
		<header class="row between">
			<div class="col">
				<div class="t-h3">{ lib.Name }</div>
				<div class="t-small mono">{ "/" + lib.Slug }</div>
			</div>
			<a class="btn small" href={ templ.SafeURL("/app/library?lib=" + lib.Slug) }>Open</a>
		</header>

		<table class="paths-table">
			<thead>
				<tr>
					<th>Path</th>
					<th>Files</th>
					<th>Discovered</th>
					<th>Last scan</th>
					<th></th>
				</tr>
			</thead>
			<tbody>
				for _, p := range paths {
					if p.LibraryID == lib.ID {
						@pathRow(p)
					}
				}
				if !hasPaths(paths, lib.ID) {
					<tr>
						<td colspan="5" class="t-small italic">No paths registered yet.</td>
					</tr>
				}
			</tbody>
		</table>

		<form class="row gap-2 mt-2" method="post" action="/app/settings/libraries/paths">
			<input type="hidden" name="library_id" value={ lib.ID }/>
			<input class="input grow" type="text" name="path" placeholder="/absolute/path/to/books" required/>
			<button class="btn small primary" type="submit">Add path</button>
		</form>
	</article>
}

templ pathRow(p model.LibraryPath) {
	<tr>
		<td class="mono">{ p.Path }</td>
		<td class="mono">{ component.IntStr(p.FileCount) }</td>
		<td class="mono">{ component.IntStr(p.DiscoveredCount) }</td>
		<td class="mono">{ lastScanLabel(p) }</td>
		<td class="row gap-2">
			<form method="post" action={ templ.SafeURL("/app/settings/libraries/paths/" + p.ID + "/scan") }>
				<button class="btn small" type="submit" title="Scan this path now">Scan</button>
			</form>
			<form method="post" action={ templ.SafeURL("/app/settings/libraries/paths/" + p.ID + "/delete") }>
				<button class="btn small ghost" type="submit" title="Stop tracking this path">Remove</button>
			</form>
		</td>
	</tr>
}

func lastScanLabel(p model.LibraryPath) string {
	if p.LastScannedAt == nil {
		return "never"
	}
	return p.LastScannedAt.Format("2006-01-02 15:04")
}

func hasPaths(paths []model.LibraryPath, libraryID string) bool {
	for _, p := range paths {
		if p.LibraryID == libraryID {
			return true
		}
	}
	return false
}
