package page

import "github.com/blackforge/embookshelf/internal/view/layout"

templ Login(next, email, errorMsg string) {
	@layout.Auth("Sign in") {
		<section class="auth-card">
			<div class="col gap-2">
				<div class="t-micro">embookshelf</div>
				<h1 class="t-h1 italic">Sign in</h1>
				<p class="t-small">Your library. On your hardware.</p>
			</div>
			<form method="post" action="/login" class="col gap-4 mt-4">
				<input type="hidden" name="next" value={ next }/>
				if errorMsg != "" {
					<div class="flash error">{ errorMsg }</div>
				}
				<div class="col gap-1">
					<label class="t-label">Email</label>
					<input class="input" name="email" type="email" required autofocus value={ email }/>
				</div>
				<div class="col gap-1">
					<label class="t-label">Password</label>
					<input class="input" name="password" type="password" required minlength="1"/>
				</div>
				<button type="submit" class="btn primary">Sign in</button>
			</form>
			<div class="t-small mt-4">
				<a href="/signup" class="link">First run? Create the admin account</a>
			</div>
		</section>
	}
}
