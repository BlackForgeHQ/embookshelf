package layout

templ App(title string) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width,initial-scale=1"/>
			<title>{ title } · embookshelf</title>
			<link rel="stylesheet" href="/static/app.css"/>
			<script src="/static/htmx.min.js" defer></script>
			<script src="/static/sse.js" defer></script>
			<script src="/static/enrich.js" defer></script>
		</head>
		<body class="h-full bg-paper-1 text-ink-1 font-serif" hx-boost="true">
			{ children... }
		</body>
	</html>
}
