package partial

import (
	"path/filepath"

	"github.com/blackforge/embookshelf/internal/model"
	"github.com/blackforge/embookshelf/internal/view/component"
)

// BookDropRow is a single row in the ingest queue. It's rendered inline
// during page load and later refetched via the SSE-driven client when the
// worker updates the item's state.
templ BookDropRow(it model.BookDropItem) {
	<tr id={ "bdrop-row-" + it.ID } class={ "bdrop-row", "state-" + string(it.State) }>
		<td class="bdrop-thumb">
			if it.HasCover {
				<img class="bdrop-cover" src={ "/app/bookdrop/" + it.ID + "/cover" } alt="" loading="lazy"/>
			} else {
				<div class="bdrop-cover placeholder"></div>
			}
		</td>
		<td class="bdrop-file">
			<div class="col">
				<span class="t-body">{ displayTitle(it) }</span>
				<span class="t-small mono">{ filepath.Base(it.Path) }</span>
			</div>
		</td>
		<td class="bdrop-author">{ it.Author }</td>
		<td class="bdrop-format"><span class="chip">{ it.Format }</span></td>
		<td class="bdrop-state">
			@stateBadge(it.State)
			if it.ErrorMsg != "" {
				<div class="t-small error-msg">{ it.ErrorMsg }</div>
			}
			if it.State == model.BookDropProcessing {
				<div class="progress mt-1"><div style={ "width:" + component.IntStr(it.Progress) + "%" }></div></div>
			}
		</td>
		<td class="bdrop-actions">
			if it.State == model.BookDropReady {
				<form method="post" action={ templ.SafeURL("/app/bookdrop/" + it.ID + "/approve") }
					hx-post={ "/app/bookdrop/" + it.ID + "/approve" }
					hx-target={ "#bdrop-row-" + it.ID }
					hx-swap="outerHTML">
					<button class="btn small primary" type="submit">Approve</button>
				</form>
				<form method="post" action={ templ.SafeURL("/app/bookdrop/" + it.ID + "/reject") }
					hx-post={ "/app/bookdrop/" + it.ID + "/reject" }
					hx-target={ "#bdrop-row-" + it.ID }
					hx-swap="outerHTML">
					<button class="btn small" type="submit">Reject</button>
				</form>
			}
			if it.State == model.BookDropFailed {
				<form method="post" action={ templ.SafeURL("/app/bookdrop/" + it.ID + "/reject") }
					hx-post={ "/app/bookdrop/" + it.ID + "/reject" }
					hx-target={ "#bdrop-row-" + it.ID }
					hx-swap="outerHTML">
					<button class="btn small" type="submit">Dismiss</button>
				</form>
			}
		</td>
	</tr>
}

templ stateBadge(s model.BookDropState) {
	<span class={ "chip", "state-" + string(s) }>{ string(s) }</span>
}

func displayTitle(it model.BookDropItem) string {
	if it.Title != "" {
		return it.Title
	}
	// Before extraction we have no title; show the filename without extension.
	return filepath.Base(it.Path)
}
