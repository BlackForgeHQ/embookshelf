package partial

import (
	"github.com/blackforge/embookshelf/internal/provider"
	"github.com/blackforge/embookshelf/internal/view/component"
)

// EnrichResults is the swap target under the metadata editor after a search.
// Empty input means no hits; the template handles that inline.
templ EnrichResults(bookID string, matches []provider.Match) {
	<div id="enrich-results" class="enrich-results">
		if len(matches) == 0 {
			<div class="t-small italic">No matches. Refine the title or author and try again.</div>
		} else {
			<div class="enrich-grid">
				for _, m := range matches {
					@component.MatchCard(bookID, m)
				}
			</div>
		}
	</div>
}
