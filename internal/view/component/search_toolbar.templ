package component

import "github.com/blackforge/embookshelf/internal/model"

// SearchToolbar renders the library's search + sort + format filters.
// The search box uses hx-trigger on keyup so results swap in as the user types.
templ SearchToolbar(activeLibSlug string, p model.SearchParams) {
	<form
		class="toolbar"
		hx-get="/app/library"
		hx-target="#library-grid"
		hx-swap="outerHTML"
		hx-trigger="input changed delay:200ms from:find input[name='q'], change from:find select, change from:find input[type='checkbox']"
		hx-push-url="true"
	>
		<input type="hidden" name="lib" value={ activeLibSlug }/>
		<div class="toolbar-search">
			<input
				class="input"
				type="search"
				name="q"
				value={ p.Query }
				placeholder="Search title, author, series…"
				autocomplete="off"
			/>
		</div>
		<div class="toolbar-sort">
			<label class="t-label">Sort</label>
			<select class="input" name="sort">
				for _, opt := range model.SortOptions {
					<option value={ opt.Key } selected?={ opt.Key == p.Sort }>{ opt.Label }</option>
				}
			</select>
		</div>
		<div class="toolbar-filters">
			for _, f := range model.Formats {
				<label class={ "chip", templ.KV("active", containsStr(p.Format, f)) }>
					<input type="checkbox" name="format" value={ f } checked?={ containsStr(p.Format, f) }/>
					<span>{ f }</span>
				</label>
			}
		</div>
	</form>
}

func containsStr(haystack []string, needle string) bool {
	for _, h := range haystack {
		if h == needle {
			return true
		}
	}
	return false
}
