package component

import (
	"strings"

	"github.com/blackforge/embookshelf/internal/provider"
)

// MatchCard renders one provider hit. The outer element exposes every field
// as a data-* attribute so the small enrich.js script can copy values into
// the metadata form when the user clicks "Apply". The "Use this cover"
// button POSTs through HTMX to the server, which vets + stores the image.
templ MatchCard(bookID string, m provider.Match) {
	<article
		class="match-card"
		data-match
		data-title={ m.Title }
		data-author={ strings.Join(m.Authors, ", ") }
		data-description={ m.Description }
		data-publisher={ m.Publisher }
		data-year={ itoaEmpty(m.Year) }
		data-isbn={ m.ISBN }
		data-series={ m.Series }
		data-language={ m.Language }
		data-tags={ strings.Join(m.Categories, ", ") }
	>
		<div class="match-cover">
			if m.CoverURL != "" {
				<img src={ m.CoverURL } alt="" loading="lazy" decoding="async"/>
			} else {
				<div class="match-cover placeholder"></div>
			}
		</div>
		<div class="match-body">
			<div class="row between">
				<span class="t-micro">{ sourceLabel(m.Source) }</span>
				<span class="t-micro">{ IntStr(m.Confidence) }% match</span>
			</div>
			<div class="t-h3">{ m.Title }</div>
			if len(m.Authors) > 0 {
				<div class="t-small">{ strings.Join(m.Authors, ", ") }</div>
			}
			<div class="t-small mono match-meta">
				if m.Year > 0 {
					<span>{ IntStr(m.Year) }</span>
				}
				if m.Publisher != "" {
					<span>· { m.Publisher }</span>
				}
				if m.ISBN != "" {
					<span>· ISBN { m.ISBN }</span>
				}
			</div>
			if m.Description != "" {
				<p class="t-small match-desc">{ truncate(m.Description, 260) }</p>
			}
			<div class="row gap-2 mt-2 match-actions">
				<button type="button" class="btn small primary" data-apply-match>Apply metadata</button>
				if m.CoverURL != "" {
					<form
						method="post"
						action={ templ.SafeURL("/app/book/" + bookID + "/cover-from-url") }
						hx-post={ "/app/book/" + bookID + "/cover-from-url" }
						hx-target="#book-detail"
						hx-swap="outerHTML"
					>
						<input type="hidden" name="url" value={ m.CoverURL }/>
						<button type="submit" class="btn small">Use this cover</button>
					</form>
				}
			</div>
		</div>
	</article>
}

func itoaEmpty(n int) string {
	if n == 0 {
		return ""
	}
	return IntStr(n)
}

func sourceLabel(s provider.Source) string {
	switch s {
	case provider.SourceGoogleBooks:
		return "Google Books"
	case provider.SourceOpenLibrary:
		return "Open Library"
	}
	return string(s)
}

// truncate returns s capped at max runes, appending an ellipsis if cut. Keep
// the helper here (not in sidebar) so match cards are self-contained.
func truncate(s string, max int) string {
	if max <= 0 {
		return ""
	}
	r := []rune(s)
	if len(r) <= max {
		return s
	}
	return string(r[:max-1]) + "…"
}
