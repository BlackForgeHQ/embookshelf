package component

import "github.com/blackforge/embookshelf/internal/model"

// Cover renders either the book's real extracted image (when HasCover is set)
// or the generated palette-style placeholder as a fallback. Both paths share
// the same outer anchor + hover behavior so the grid layout stays uniform.
templ Cover(b model.Book, size string) {
	if b.HasCover {
		<a
			href={ templ.SafeURL("/app/book/" + b.ID) }
			class={ "cover", "cover-image", size }
		>
			<img
				src={ "/app/cover/" + b.ID }
				alt={ b.Title }
				loading="lazy"
				decoding="async"
			/>
			if b.Progress > 0 && b.Progress < 100 {
				<span class="cover-progress" style={ "width:" + IntStr(b.Progress) + "%" }></span>
			}
		</a>
	} else {
		<a
			href={ templ.SafeURL("/app/book/" + b.ID) }
			class={ "cover", size, "cov-" + paletteOrDefault(b.CoverPalette) }
		>
			<div class="c-top">
				<div class="c-title">{ b.Title }</div>
				<div class="c-ornament"></div>
			</div>
			<div class="c-author">{ b.Author }</div>
			if b.Progress > 0 && b.Progress < 100 {
				<span class="cover-progress" style={ "width:" + IntStr(b.Progress) + "%" }></span>
			}
		</a>
	}
}

func paletteOrDefault(p string) string {
	if p == "" {
		return "navy"
	}
	return p
}
