package component

import "github.com/blackforge/embookshelf/internal/auth"

// UserBadge renders the current-user row (avatar + name + logout) at the
// bottom of the sidebar. The user is pulled from the request context so
// every page that wraps in layout.App automatically shows it.
templ UserBadge() {
	if u := auth.UserFromContext(ctx); u != nil {
		<div class="user-badge">
			<div class="user-avatar">{ u.Initials() }</div>
			<div class="col grow">
				<div class="user-name">{ u.Display() }</div>
				<div class="t-micro">{ string(u.Role) }</div>
			</div>
			<form method="post" action="/logout">
				<button class="btn ghost icon-only" title="Sign out" type="submit">⎋</button>
			</form>
		</div>
	}
}
