package component

import "github.com/blackforge/embookshelf/internal/model"

// NavActive controls which top-level section is highlighted in the sidebar.
type NavActive string

const (
	NavDashboard NavActive = "dashboard"
	NavLibrary   NavActive = "library"
	NavBookdrop  NavActive = "bookdrop"
	NavNotebook  NavActive = "notebook"
	NavSettings  NavActive = "settings"
	NavNone      NavActive = ""
)

templ Sidebar(libraries []model.Library, shelves []model.Shelf, activeLibSlug string, activeShelfSlug string, nav NavActive) {
	<aside class="sidebar col gap-4">
		<div class="px-5 pb-3 row between">
			<span class="t-h3 italic">embookshelf</span>
			<span class="t-micro">v0.1</span>
		</div>
		<hr class="rule"/>
		<nav class="col px-3 gap-1">
			<a href="/app" class={ "nav-item", templ.KV("active", nav == NavDashboard) }>Dashboard</a>
			<a href="/app/library" class={ "nav-item", templ.KV("active", nav == NavLibrary) }>Library</a>
			<a href="/app/bookdrop" class={ "nav-item", templ.KV("active", nav == NavBookdrop) }>BookDrop</a>
			<a href="/app/notebook" class={ "nav-item", templ.KV("active", nav == NavNotebook) }>Notebook</a>
			<a href="/app/settings" class={ "nav-item", templ.KV("active", nav == NavSettings) }>Settings</a>
		</nav>
		<hr class="rule"/>
		<div class="px-5">
			<div class="t-label mb-2">Libraries</div>
			<div class="col gap-1">
				for _, lib := range libraries {
					<a
						href={ templ.SafeURL("/app/library?lib=" + lib.Slug) }
						class={ "nav-item", "sub", templ.KV("active", lib.Slug == activeLibSlug) }
					>{ lib.Name }</a>
				}
			</div>
		</div>
		<hr class="rule"/>
		<div class="px-5">
			<div class="row between mb-2">
				<div class="t-label">Shelves</div>
				<button class="btn ghost small" type="button" onclick="document.getElementById('shelf-create').classList.toggle('hidden')" title="New shelf">+</button>
			</div>
			<div class="col gap-1">
				for _, s := range shelves {
					<a
						href={ templ.SafeURL("/app/shelf/" + s.Slug) }
						class={ "nav-item", "sub", templ.KV("active", s.Slug == activeShelfSlug) }
					>
						<span>{ s.Name }</span>
						<span class="shelf-count">{ IntStr(s.BookCount) }</span>
					</a>
				}
			</div>
			<form id="shelf-create" class="shelf-create hidden mt-2" method="post" action="/app/shelves">
				<input class="input" type="text" name="name" placeholder="New shelf…" required/>
				<select class="input" name="accent">
					<option value="accent">accent</option>
					<option value="teal">teal</option>
					<option value="olive">olive</option>
					<option value="rust">rust</option>
					<option value="plum">plum</option>
					<option value="forest">forest</option>
				</select>
				<button class="btn small primary" type="submit">Create</button>
			</form>
		</div>
		<div class="grow"></div>
		@UserBadge()
	</aside>
}

// IntStr formats an int without pulling in fmt; exported so other templates
// can reuse it for small counters.
func IntStr(n int) string {
	if n == 0 {
		return "0"
	}
	neg := n < 0
	if neg {
		n = -n
	}
	var buf [20]byte
	i := len(buf)
	for n > 0 {
		i--
		buf[i] = byte('0' + n%10)
		n /= 10
	}
	if neg {
		i--
		buf[i] = '-'
	}
	return string(buf[i:])
}
