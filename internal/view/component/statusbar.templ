package component

import "fmt"

templ StatusBar(libCount, bookCount int, diskMode string) {
	<footer class="status-bar">
		<span class="status-dot green"></span>
		<span>embookshelf 0.1 · { diskMode } mode</span>
		<span>·</span>
		<span>{ fmt.Sprintf("%d libraries · %d volumes", libCount, bookCount) }</span>
		<span>·</span>
		<span>postgres · connected</span>
		<div class="grow"></div>
		<span>⌘K to search</span>
	</footer>
}
